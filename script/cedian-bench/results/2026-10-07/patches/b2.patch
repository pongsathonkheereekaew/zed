+/// Host-device probe for OMP 18.6 host tools.
+///
+/// OMP runs cedian host tools as writes to `xd://<tool>` (executing the tool);
+/// a read of `xd://<tool>` only fetches the tool's docs/schema. Both arrive
+/// as plain `read`/`write` calls whose args preview is the device path, so
+/// without this probe the transcript shows them as file reads/writes.
+///
+/// Returns the host tool name and whether the call executes it (`true` for a
+/// write) or only reads its docs (`false` for a read). `None` for anything
+/// else: other tools, non-device paths, an empty device (`xd://`).
+pub fn host_device<'a>(name: &str, preview: &'a str) -> Option<(&'a str, bool)> {
+    let execute = match name {
+        "write" => true,
+        "read" => false,
+        _ => return None,
+    };
+    let tool = preview.strip_prefix("xd://")?;
+    if tool.is_empty() || tool.contains('/') {
+        return None;
+    }
+    Some((tool, execute))
+}
