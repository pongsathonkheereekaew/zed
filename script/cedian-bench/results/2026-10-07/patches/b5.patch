+/// A tool call that ran to completion: name and arg summary from its
+/// `ToolStart`, error flag from its `ToolEnd`. Enters the finished log only
+/// when the `ToolEnd` arrives — a `ToolStart` alone never records one.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FinishedToolCall {
+    /// Tool name from the `ToolStart` (falls back to the `ToolEnd` name when
+    /// no start was seen).
+    pub tool_name: String,
+    /// One-line arg summary from the `ToolStart` (empty when no start seen).
+    pub args_preview: String,
+    /// Error flag from the `ToolEnd`.
+    pub is_error: bool,
+}
+
