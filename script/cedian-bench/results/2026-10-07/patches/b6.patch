diff --git a/crates/cedian_omp/src/headless_ui.rs b/crates/cedian_omp/src/headless_ui.rs
new file mode 100644
index 0000000..1b64ecd
--- /dev/null
+++ b/crates/cedian_omp/src/headless_ui.rs
@@ -0,0 +1,133 @@
+//! Fail-closed answers for extension UI dialogs when no UI can approve.
+//!
+//! Headless `cedian` (the CLI) never answers OMP's extension UI dialogs, so
+//! an approval dialog stalls the turn until the prompt timeout. With denial
+//! armed ([`crate::OmpRuntime::deny_ui_requests`]) the runtime answers every
+//! dialog on the host's behalf: deny, decline, or cancel — never approve.
+
+use omp_rpc::{
+    CancelUiResponse, ConfirmUiResponse, ExtensionUiRequest, ExtensionUiResponse, LitTrue,
+    ValueUiResponse,
+};
+
+/// Answer one extension UI request without a human.
+///
+/// Returns `None` for fire-and-forget requests (`notify`, `setStatus`,
+/// `setWidget`, `setTitle`, `set_editor_text`, `open_url`, `cancel`) which
+/// need no answer. Otherwise returns the fail-closed response plus a one-line
+/// label of the dialog title for the refused log.
+pub fn headless_answer(request: &ExtensionUiRequest) -> Option<(ExtensionUiResponse, String)> {
+    match request {
+        ExtensionUiRequest::Select(select) => {
+            let label = one_line(&select.title);
+            match select
+                .options
+                .iter()
+                .find(|option| option.eq_ignore_ascii_case("deny"))
+            {
+                Some(deny) => Some((
+                    ExtensionUiResponse::ValueUiResponse(ValueUiResponse {
+                        id: select.id.clone(),
+                        value: deny.clone(),
+                    }),
+                    label,
+                )),
+                None => Some((cancel(&select.id), label)),
+            }
+        }
+        ExtensionUiRequest::Confirm(confirm) => Some((
+            ExtensionUiResponse::ConfirmUiResponse(ConfirmUiResponse {
+                id: confirm.id.clone(),
+                confirmed: false,
+            }),
+            one_line(&confirm.title),
+        )),
+        ExtensionUiRequest::Input(input) => Some((cancel(&input.id), one_line(&input.title))),
+        ExtensionUiRequest::Editor(editor) => Some((cancel(&editor.id), one_line(&editor.title))),
+        ExtensionUiRequest::Ask(ask) => {
+            let label = ask
+                .questions
+                .first()
+                .map(|question| one_line(&question.question))
+                .unwrap_or_else(|| one_line(&ask.id));
+            Some((cancel(&ask.id), label))
+        }
+        // Fire-and-forget: no answer expected.
+        _ => None,
+    }
+}
+
+/// Collapse a dialog title to one line (newlines never reach the log).
+fn one_line(text: &str) -> String {
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+/// Dismiss a dialog without answering it.
+fn cancel(id: &str) -> ExtensionUiResponse {
+    ExtensionUiResponse::CancelUiResponse(CancelUiResponse {
+        id: id.to_string(),
+        cancelled: LitTrue,
+        timed_out: None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn request(v: serde_json::Value) -> ExtensionUiRequest {
+        ExtensionUiRequest::from_value(v).expect("valid request")
+    }
+
+    #[test]
+    fn approval_select_is_denied() {
+        let r = request(json!({
+            "type": "extension_ui_request", "method": "select", "id": "u1",
+            "title": "Allow tool: bash\nCommand: ls", "options": ["Approve", "Deny"]
+        }));
+        let (reply, label) = headless_answer(&r).unwrap();
+        assert_eq!(
+            reply,
+            ExtensionUiResponse::ValueUiResponse(ValueUiResponse {
+                id: "u1".into(),
+                value: "Deny".into()
+            })
+        );
+        assert_eq!(label, "Allow tool: bash — Command: ls");
+    }
+
+    #[test]
+    fn confirm_is_declined_and_notify_needs_no_reply() {
+        let r = request(json!({
+            "type": "extension_ui_request", "method": "confirm", "id": "u2",
+            "title": "Run?", "message": "really"
+        }));
+        assert!(matches!(
+            headless_answer(&r),
+            Some((
+                ExtensionUiResponse::ConfirmUiResponse(ConfirmUiResponse {
+                    confirmed: false,
+                    ..
+                }),
+                _
+            ))
+        ));
+        let n = request(json!({
+            "type": "extension_ui_request", "method": "notify", "id": "u3", "message": "hi"
+        }));
+        assert!(headless_answer(&n).is_none());
+    }
+
+    #[test]
+    fn select_without_deny_is_dismissed() {
+        let r = request(json!({
+            "type": "extension_ui_request", "method": "select", "id": "u4",
+            "title": "Pick", "options": ["a", "b"]
+        }));
+        assert!(matches!(
+            headless_answer(&r),
+            Some((ExtensionUiResponse::CancelUiResponse(_), _))
+        ));
+    }
+}
