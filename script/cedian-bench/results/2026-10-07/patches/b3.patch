+/// True when every commit on `branch` is reachable from `HEAD`.
+/// `merge-base --is-ancestor` exits 1 (not failure) for unmerged, so this
+/// needs the raw status instead of the `git` helper.
+fn is_merged(repo: &Path, branch: &str) -> Result<bool, WorkerError> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(repo)
+        .arg("merge-base")
+        .arg("--is-ancestor")
+        .arg(branch)
+        .arg("HEAD")
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_INDEX_FILE")
+        .env_remove("GIT_WORK_TREE")
+        .output()
+        .map_err(|e| WorkerError::Git(e.to_string()))?;
+    match out.status.code() {
+        Some(0) => Ok(true),
+        Some(1) => Ok(false),
+        _ => Err(WorkerError::Git(
+            String::from_utf8_lossy(&out.stderr).trim().to_string(),
+        )),
+    }
+}
