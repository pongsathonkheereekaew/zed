+    /// Finished tool call by id, or `None` until its `ToolEnd` arrives (a
+    /// `ToolStart` alone never records one). `tool_name`/`args_preview` come
+    /// from the matching `ToolStart` — falling back to the `ToolEnd` name and
+    /// an empty preview when no start was seen; `is_error` comes from the
+    /// `ToolEnd`. Derived from the append-only log: no extra state to drift.
+    pub fn finished_tool_call(&self, tool_call_id: &str) -> Option<FinishedToolCall> {
+        let log = self.inner.lock().log.clone();
+        let mut start: Option<(String, String)> = None;
+        let mut end: Option<(String, bool)> = None;
+        for entry in &log {
+            match &entry.event {
+                RouterEvent::ToolStart {
+                    tool_call_id: id,
+                    tool_name,
+                    args_preview,
+                } if id.as_str() == tool_call_id => {
+                    start = Some((tool_name.clone(), args_preview.clone()));
+                }
+                RouterEvent::ToolEnd {
+                    tool_call_id: id,
+                    tool_name,
+                    is_error,
+                    ..
+                } if id.as_str() == tool_call_id => {
+                    end = Some((tool_name.clone(), *is_error));
+                }
+                _ => {}
+            }
+        }
+        end.map(|(end_name, is_error)| {
+            let (tool_name, args_preview) = start.unwrap_or_else(|| (end_name, String::new()));
+            FinishedToolCall {
+                tool_name,
+                args_preview,
+                is_error,
+            }
+        })
+    }
