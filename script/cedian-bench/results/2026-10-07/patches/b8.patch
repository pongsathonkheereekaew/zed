diff --git a/crates/cedian_workflow/src/profile.rs b/crates/cedian_workflow/src/profile.rs
index 7df0d98..be4dd3e 100644
--- a/crates/cedian_workflow/src/profile.rs
+++ b/crates/cedian_workflow/src/profile.rs
@@ -14,6 +14,39 @@ pub enum TaskKind {
     Performance,
     Prototype,
 }
+impl TaskKind {
+    /// Every kind, in serde order. The spelling lives on the enum
+    /// (`snake_case`); this lists variants, never strings.
+    pub const ALL: [Self; 6] = [
+        Self::Investigation,
+        Self::BugFix,
+        Self::Feature,
+        Self::Refactor,
+        Self::Performance,
+        Self::Prototype,
+    ];
+
+    /// Parse one serde name (`bug_fix`, …) — the same spelling the workflow
+    /// channel deserializes. Unknown input fails listing every kind.
+    pub fn parse(s: &str) -> Result<Self, String> {
+        serde_json::from_value::<Self>(serde_json::Value::String(s.to_owned()))
+            .map_err(|_| format!("unknown kind {s:?} ({})", Self::list()))
+    }
+
+    /// `investigation|bug_fix|…`, derived from serde (no second spelling).
+    pub fn list() -> String {
+        Self::ALL
+            .iter()
+            .map(|k| {
+                serde_json::to_value(k)
+                    .ok()
+                    .and_then(|v| v.as_str().map(str::to_owned))
+                    .unwrap_or_else(|| "?".to_owned())
+            })
+            .collect::<Vec<_>>()
+            .join("|")
+    }
+}
 
